{
  "schemaVersion": 1,
  "kind": "liara-docker-app",
  "name": "liara-docs-ai-gateway",
  "dockerfile": "deploy/liara/Dockerfile.gateway",
  "buildContext": ".",
  "port": 4000,
  "healthCheckPath": "/health/readiness",
  "privateDependencies": ["managed-redis", "meilisearch"],
  "minimumReplicas": 2,
  "buildArgumentNames": ["APPROVED_CORPUS_REVISION"],
  "configurationNames": [
    "AI_GATEWAY_MODEL_NAME",
    "AI_GATEWAY_MODEL",
    "AI_GATEWAY_API_BASE",
    "AI_GATEWAY_API_KEY",
    "AI_GATEWAY_REDIS_URL",
    "AI_GATEWAY_MEILI_URL",
    "AI_GATEWAY_MEILI_API_KEY",
    "AI_GATEWAY_LIARA_INDEX_UID",
    "AI_GATEWAY_LIARA_CORPUS_REVISION",
    "AI_GATEWAY_IDENTITY_SECRET",
    "AI_GATEWAY_CACHE_HMAC_SECRET",
    "AI_GATEWAY_METRICS_TOKEN",
    "AI_GATEWAY_CORS_ALLOW_ORIGINS",
    "AI_GATEWAY_TRUSTED_PROXY_CIDRS",
    "AI_GATEWAY_INPUT_COST_MICRO_PER_MILLION",
    "AI_GATEWAY_OUTPUT_COST_MICRO_PER_MILLION",
    "AI_GATEWAY_DAILY_COST_BUDGET_MICRO",
    "AI_GATEWAY_DEPLOYMENT_ID",
    "AI_GATEWAY_ENFORCEMENT_EPOCH"
  ]
}
