    "@hackathon/contracts": "workspace:*",
    "@nestjs/common": "10.4.20",
    "@nestjs/core": "10.4.20",
    "@nestjs/platform-express": "10.4.20",
    "@nestjs/throttler": "6.4.0",
    "drizzle-orm": "0.44.5",
    "express": "4.21.2",
    "postgres": "3.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.20",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.3.0",
    "drizzle-kit": "0.31.4",
    "jest": "30.0.5",
    "ts-jest": "29.4.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
